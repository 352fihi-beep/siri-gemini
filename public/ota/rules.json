{
  "version": 7,
  "rules": [
    {
      "id": "battery",
      "match": ["battery", "charge", "power left", "percent", "battery level", "how much battery", "airpods battery", "case battery", "left battery", "right battery", "juice", "how much power", "battery percentage", "what's my battery", "battery status", "remaining battery", "battery remaining", "how much charge", "power remaining", "buds battery", "case charge", "left charge", "right charge", "battery check", "battery life", "check battery", "what's the battery", "pod battery", "remaining power", "how full", "airpod battery"],
      "action": "battery",
      "reply": "Reporting last-seen Continuity batteries."
    },
    {
      "id": "anc",
      "match": ["anc", "noise cancell", "noise cancel", "noise cancelling", "quiet the world", "anc on", "cancel noise", "active noise", "noise canceling", "block noise", "silence mode", "noise cancellation", "turn on anc", "enable anc", "quiet mode", "noise cancelling mode", "anc mode", "noise cancelling on", "activate noise cancellation", "turn on noise cancelling", "block the noise", "activate anc"],
      "action": "noise_anc",
      "reply": "Noise cancellation."
    },
    {
      "id": "trans",
      "match": ["transparency", "transparent", "ambient", "transparency mode", "hear through", "pass through", "hear outside", "ambient mode", "hear the room", "outside sound", "transparency on", "turn on transparency", "enable transparency", "hear surroundings", "pass-through", "ambient sound", "pass through mode", "hear ambient", "transparency mode on"],
      "action": "noise_trans",
      "reply": "Transparency."
    },
    {
      "id": "adaptive",
      "match": ["adaptive", "adaptive audio"],
      "action": "noise_adaptive",
      "reply": "Adaptive."
    },
    {
      "id": "off",
      "match": ["noise off", "anc off", "turn off noise", "noise control off"],
      "action": "noise_off",
      "reply": "Noise control off."
    },
    {
      "id": "play",
      "match": ["play", "resume", "play music", "start playing", "unpause", "continue", "play song", "start music", "continue playing", "play audio", "resume playback", "start playback", "resume music", "play it", "unpause the music", "resume the song"],
      "action": "play",
      "reply": "Playing."
    },
    {
      "id": "pause",
      "match": ["pause", "stop music", "stop", "pause music", "halt", "pause song", "stop playing", "hold music", "pause playback", "stop audio", "pause audio", "halt music", "pause it", "stop the music", "hold playback"],
      "action": "pause",
      "reply": "Paused."
    },
    {
      "id": "loudness_off",
      "match": ["loudness off", "boost off"],
      "action": "loudness_off",
      "reply": "Loudness off."
    },
    {
      "id": "loudness_max",
      "match": ["max boost", "max loudness", "loudness max"],
      "action": "loudness_max",
      "reply": "Loudness +15 dB."
    },
    {
      "id": "loudness_on",
      "match": ["boost volume", "volume boost", "make it louder"],
      "action": "loudness_on",
      "reply": "Loudness +9 dB."
    }
  ]
}
