{
  "version": 4,
  "rules": [
    {
      "id": "battery",
      "match": ["battery", "charge", "power left", "percent", "battery level", "how much battery", "airpods battery", "case battery", "left battery", "right battery", "juice", "how much power", "battery percentage", "what's my battery", "battery status"],
      "action": "battery",
      "reply": "Reporting last-seen Continuity batteries."
    },
    {
      "id": "anc",
      "match": ["anc", "noise cancell", "noise cancel", "noise cancelling", "quiet the world", "anc on", "cancel noise", "active noise", "noise canceling", "block noise", "silence mode"],
      "action": "noise_anc",
      "reply": "Noise cancellation."
    },
    {
      "id": "trans",
      "match": ["transparency", "transparent", "ambient", "transparency mode", "hear through", "pass through", "hear outside", "ambient mode", "hear the room", "outside sound"],
      "action": "noise_trans",
      "reply": "Transparency."
    },
    {
      "id": "adaptive",
      "match": ["adaptive", "adaptive audio"],
      "action": "noise_adaptive",
      "reply": "Adaptive."
    },
    {
      "id": "off",
      "match": ["noise off", "anc off", "turn off noise", "noise control off"],
      "action": "noise_off",
      "reply": "Noise control off."
    },
    {
      "id": "play",
      "match": ["play", "resume", "play music", "start playing", "unpause", "continue", "play song", "start music", "continue playing"],
      "action": "play",
      "reply": "Playing."
    },
    {
      "id": "pause",
      "match": ["pause", "stop music", "stop", "pause music", "halt", "pause song", "stop playing", "hold music"],
      "action": "pause",
      "reply": "Paused."
    }
  ]
}
